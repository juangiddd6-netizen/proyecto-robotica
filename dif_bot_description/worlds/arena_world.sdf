<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arena_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></visual>
      </link>
    </model>
    <model name="wall_n"><static>true</static><pose>0 5 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -5 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>10.2 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>10.2 0.2 1</size></box></geometry></visual></link></model>
    <model name="wall_e"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 1</size></box></geometry></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 10 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 1</size></box></geometry></visual></link></model>
    <model name="obs_1"><static>true</static><pose>1.6 -2.2 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 3.5 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 3.5 1</size></box></geometry></visual></link></model>
    <model name="obs_2"><static>true</static><pose>-1.8 1.8 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3.5 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>3.5 0.2 1</size></box></geometry></visual></link></model>
    <model name="obs_3"><static>true</static><pose>2.5 2.5 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.8 0.8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.8 0.8 1</size></box></geometry></visual></link></model>
    <model name="obs_4"><static>true</static><pose>-2.5 -2.0 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 0.6 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.6 1</size></box></geometry></visual></link></model>
  </world>
</sdf>
