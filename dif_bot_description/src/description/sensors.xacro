<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <gazebo reference="front_caster">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <link name="imu_link">
    <visual><geometry><box size="0.05 0.05 0.02"/></geometry><material name="Red"><color rgba="1 0 0 1"/></material></visual>
    <collision><geometry><box size="0.05 0.05 0.02"/></geometry></collision>
    <xacro:inertial_box mass="0.05" x="0.05" y="0.05" z="0.02"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_box>
  </link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu"><always_on>true</always_on><update_rate>50</update_rate><topic>imu/data</topic><gz_frame_id>imu_link</gz_frame_id></sensor>
  </gazebo>

  <link name="laser_frame">
    <visual><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="Black"><color rgba="0 0 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
    <xacro:inertial_cylinder mass="0.1" radius="0.05" length="0.04"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_cylinder>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0 0 ${base_height/2 + 0.02}" rpy="0 0 0"/></joint>
  <gazebo reference="laser_frame">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on><visualize>true</visualize><update_rate>10</update_rate><topic>scan</topic><gz_frame_id>laser_frame</gz_frame_id>
      <lidar>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <visual><geometry><box size="0.03 0.08 0.03"/></geometry><material name="Blue"><color rgba="0 0 1 1"/></material></visual>
    <collision><geometry><box size="0.03 0.08 0.03"/></geometry></collision>
    <xacro:inertial_box mass="0.05" x="0.03" y="0.08" z="0.03"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_box>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="${base_length/2 + 0.015} 0 0" rpy="0 0 0"/></joint>
</robot>
